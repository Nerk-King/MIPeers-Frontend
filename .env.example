# Demo mode is ON by default for everything (login, chat, uploads, knowledge library) — safe for
# anyone pulling the repo. It's controlled at runtime by the Live/Demo pill in the topbar, not by
# env vars (see src/services/liveMode.ts). The vars below only override *where* real calls go.

# Overrides the default ilDecision:ragAsk endpoint (https://mn2503.ils.mip.co.za/web_pvtken/rest.w).
# Never put private RAG credentials in VITE variables.
VITE_RAG_ENDPOINT=

# Overrides the default ilRest:getUserStaffNo login endpoint (https://mn2503.ils.mip.co.za/web_pvtken/rest.w).
VITE_AUTH_ENDPOINT=

# Overrides the default ilDecision:ragUpload endpoint (https://mn2503.ils.mip.co.za/web_pvtken/rest.w).
VITE_UPLOAD_ENDPOINT=

# Overrides the default ilDecision:ragKnowledgeBase endpoint (https://mn2503.ils.mip.co.za/web_pvtken/rest.w).
VITE_KNOWLEDGE_ENDPOINT=

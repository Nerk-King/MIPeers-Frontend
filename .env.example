# Overrides the default ilDecision:ragAsk endpoint (https://mn2503.ils.mip.co.za/web_pvtken/rest.w).
# Never put private RAG credentials in VITE variables.
VITE_RAG_ENDPOINT=

# Demo mode (local sample answers) is ON by default. Set to "false" to call the real ragAsk service.
VITE_RAG_DEMO=

# Overrides the default ilRest:getUserStaffNo login endpoint (https://mn2503.ils.mip.co.za/web_pvtken/rest.w).
VITE_AUTH_ENDPOINT=

# Demo mode (local dummy credential check) is ON by default. Set to "false" to call the real login service.
VITE_AUTH_DEMO=
